# Copy to .env; keep credentials local. PostgreSQL/PostGIS and Redis are required.
NODE_ENV=development
PORT=3000
# Optional legacy CORS origin aliases. APP_BASE_URL below is the canonical origin.
APP_URL=
FRONTEND_URL=
DISABLE_HMR=false

# Transactional email (server-only). Never use VITE_RESEND_API_KEY.
# For local Resend testing, EMAIL_FROM can be "Stanza <onboarding@resend.dev>".
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Base64-encoded 32-byte AES-256-GCM key used only to re-render authorised
# stable QR badge URLs. Generate and keep server-side; never prefix with VITE_.
QR_TOKEN_ENCRYPTION_KEY=

# VITE_API_BASE_URL: Leave empty for local dev and full-stack production preview.
# Express serves the built frontend and /api from the same origin (default :3000).
# Vite preview (:4173) is frontend-only; use npm run preview:full for Login/API tests.
VITE_API_BASE_URL=

# Public deployment origin used by metadata tooling. Do not include secrets.
VITE_PUBLIC_APP_URL=https://stanza-demo.onrender.com

# Public demo cards use ordinary email/password login. These flags apply only
# to destructive demo seed/reset scripts, never normal authentication.
ALLOW_DEMO_DATA_MUTATION=false
DEMO_DATABASE_ALLOWLIST=
DEMO_DATABASE_NAME=
DEMO_RESET_CONFIRM=
# Required only when seeding the isolated demo database; never log or expose it.
DEMO_PASSWORD=

# QA/demo mutation guard. Required by smoke and Hiring integration scripts.
ALLOW_TEST_DATA_MUTATION=false
TEST_TARGET_ALLOWLIST=
TEST_DATABASE_ALLOWLIST=
ALLOW_NONLOCAL_TEST_TARGET=false
ALLOW_PRODUCTION_TEST_TARGET=false
TEST_DATA_NONINTERACTIVE=false
TEST_DATA_CONFIRM=

# DATABASE_URL: PostgreSQL connection string used by HR persistence endpoints.
DATABASE_URL=

# DATABASE_SSL: Set to true for hosted PostgreSQL providers that require SSL.
DATABASE_SSL=
DATABASE_SSL_CA=
# Number of trusted reverse-proxy hops in front of Express. Keep 0 when clients
# connect directly; set to the exact deployment topology when behind a proxy.
# Never increase this to accept arbitrary client-supplied X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Local development only: allow a same-origin HTTPS Cloudflare Quick Tunnel.
# The server and production build reject this flag when NODE_ENV/mode is production.
ALLOW_TRYCLOUDFLARE_DEV_ORIGINS=false

# WebAuthn/passkey relying party settings.
# Localhost:
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000
# Cloudflare tunnel / production must match the exact HTTPS origin used in the browser.
WEBAUTHN_RP_NAME=Stanza
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# CORS_ALLOWED_ORIGINS: Optional comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# DEV_AUTH_HEADERS: Optional local-only escape hatch for legacy x-employee-id/x-tenant-id headers.
# Leave unset in production.
DEV_AUTH_HEADERS=

# MAPTILER_KEY: Server-only key used by /api/map-tiles to proxy map tiles.
# Do not prefix this with VITE_; VITE_ variables are exposed to browser code.
MAPTILER_KEY=

# VITE_MAPTILER_KEY: Public browser map key for MapLibre/MapTiler signup maps.
VITE_MAPTILER_KEY=

# MAPTILER_MAP_ID: Optional MapTiler map style id. Defaults to streets-v4.
MAPTILER_MAP_ID=

# Redis connection used by BullMQ background jobs. REDIS_URL takes precedence and
# supports redis:// for local/hosted Redis and rediss:// for TLS providers such as Upstash.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Document extraction is disabled until a provider adapter is configured.
# The deterministic fixture is accepted only when NODE_ENV=test and must never
# be used as a production OCR provider.
DOCUMENT_EXTRACTION_PROVIDER=
DOCUMENT_EXTRACTION_RETENTION_HOURS=4
DOCUMENT_EXTRACTION_TEMP_DIR=
ALLOW_DOCUMENT_EXTRACTION_FIXTURES=false
LIVE_EMPLOYEE_OVERDUE_HOURS=12

# JSON_BODY_LIMIT: Optional Express JSON body limit, e.g. 1mb.
JSON_BODY_LIMIT=

# Local avatar storage. This directory is suitable for development only; use a
# durable mounted volume or object-storage adapter in production.
PROFILE_IMAGE_DIRECTORY=uploads/profile-images

# Local Company Feed image storage. Files are re-encoded as WebP and served
# through authenticated tenant-scoped API routes, never as a public directory.
COMPANY_FEED_IMAGE_DIRECTORY=uploads/company-feed

# Local backend smoke test credentials. These values are read only by scripts/smoke-test.ts.
# Use a dedicated local hr_admin account and never commit real credentials.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
SMOKE_TEST_BASE_URL=http://localhost:3000

# Optional security-test fixtures. Use dedicated local accounts only.
SECURITY_TEST_ADMIN_EMAIL=
SECURITY_TEST_ADMIN_PASSWORD=
SECURITY_TEST_EMPLOYEE_EMAIL=
SECURITY_TEST_EMPLOYEE_PASSWORD=
SECURITY_TEST_BASE_URL=http://localhost:3000

# Demo attendance fallback is development-only; normal database-backed login remains required.
STANZA_DEMO_ENV=false
# Legacy demo databases lacking the marker column require explicit tenant identification.
DEMO_TENANT_ID=
# Private grievance attachments must reside on durable storage in production.
GRIEVANCE_ATTACHMENT_DIRECTORY=uploads/private-grievances

# Opt-in production-build diagnostic instruments; leave disabled for normal builds.
STANZA_LOGIN_CONTROL_DIAGNOSTIC=false
STANZA_LOGIN_IDLE_CANVAS_DIAGNOSTIC=false
STANZA_LOGIN_AUTOFILL_DIAGNOSTIC=false
STANZA_LOGIN_ANIMATION_AUDIT=false

# Integration targets and disposable fixture accounts; never use real employee credentials.
HIRING_TEST_BASE_URL=http://localhost:3000
HIRING_TEST_ADMIN_EMAIL=
HIRING_TEST_MANAGER_EMAIL=
HIRING_TEST_EMPLOYEE_EMAIL=
HIRING_TEST_PASSWORD=
HIRING_ROLE_TEST_BASE_URL=http://localhost:3000
ATTENDANCE_TEST_BASE_URL=http://localhost:3000
COMMUNICATIONS_TEST_BASE_URL=http://localhost:3000

# Private asset evidence storage and roster warning threshold (hours per week).
ASSET_EVIDENCE_DIRECTORY=uploads/assets
ROSTER_WEEKLY_HOURS_THRESHOLD=40
ORGANISATION_CONCURRENCY_TEST=false
SESSIONS_TEST_BASE_URL=http://localhost:3000
AUDIT_TEST_BASE_URL=http://localhost:3000
API_ROUTING_TEST_BASE_URL=http://localhost:3000
RELIABILITY_TEST_BASE_URL=http://localhost:3000
RELIABILITY_ADMIN_EMAIL=
RELIABILITY_ADMIN_PASSWORD=
RELIABILITY_EMPLOYEE_EMAIL=
RELIABILITY_EMPLOYEE_PASSWORD=

# Dedicated localhost Redis for optional disposable dev/worker smoke checks.
WORKER_SMOKE_REDIS_URL=

# Production deployment uses one web replica until authentication limiters are shared.
WEB_REPLICAS=1
# Explicitly acknowledge plaintext PostgreSQL only within an isolated private network.
DATABASE_ALLOW_PLAINTEXT=false
DATABASE_POOL_MAX=10
# Production filesystem directories above must be absolute durable volume paths.

# Intelligent Command Router: separate server-only provider keys; no inference by default.
# Modes: disabled, user-authorized, tenant-provided, application-funded.
# User mode supports ephemeral localhost preview OAuth below; hosted deployments still require registration.
# Tenant mode requires a deployment authorization adapter.
STANZA_ROUTER_AI_MODE=disabled
STANZA_ROUTER_REASONING_KEY=
STANZA_ROUTER_REASONING_MODEL=gpt-6.1-sol
STANZA_ROUTER_REASONING_EFFORT=low
STANZA_ROUTER_ESCALATE_COMPLEX=false
# Local CPU embeddings are the default; prepare the pinned cache with npm run db:prepare:router.
STANZA_ROUTER_EMBEDDING_PROVIDER=local
# Optional external embeddings require explicit provider=openai; this key is ignored by local.
# Local preview: configure this in ignored .env.development.local; never paste or commit keys.
STANZA_ROUTER_EMBEDDING_KEY=
STANZA_ROUTER_EMBEDDING_MODEL=text-embedding-3-small
STANZA_ROUTER_EMBEDDING_DIMENSIONS=1536
STANZA_ROUTER_EMBEDDING_VERSION=v1
# Provisional score/margin thresholds: calibrate with a real embedding provider.
STANZA_ROUTER_MIN_SCORE=0.84
STANZA_ROUTER_MIN_MARGIN=0.10
STANZA_ROUTER_TOP_K=32
# Saving a raw normalized candidate also requires explicit palette opt-in.
STANZA_ROUTER_LEARNING=false

# Local built application (web + worker): npm run preview:full
# Uses local dotenv files, localhost and existing PostgreSQL/Redis. npm start stays production-only.
# Stop npm run dev first if it already uses PORT (default 3000).

# Optional ChatGPT-plan OAuth, only in loopback-only preview:full. No client secret.
# Set mode=user-authorized, enable below, and generate/persist one UUID v4 host ID locally.
# Local Windows preview stores credentials encrypted in .cache/stanza-openai.
# AES-GCM uses a separate DPAPI CurrentUser-protected key; no token/browser/API-key fallback.
# The local vault is unavailable in production or on unsupported operating systems.
STANZA_ROUTER_OPENAI_LOCAL_AUTH=false
STANZA_ROUTER_OPENAI_HOST_ID=
